<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
    <meta charset="UTF-8">
    <title>Dive Sites - Bhaccasyoniztas Beach Resort Website Template</title>
    <link href="https://jsdelivr.net" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
</head>
<body>
    <div id="background">
        <div id="page">
            {{> header}}
            <div id="contents">
                <div class="box">
                    <div>
                        <div class="body">
                            <h1>Travel</h1>
                            <ul id="sites">
                                {{#each trips}}
                                <li>
                                    
                                    <a href="/api/trips/{{this.code}}">
                                        
                                        <img src="images/{{this.image}}" alt="Img">
                                    </a>
                                    <h2><a href="/travel">{{this.name}}</a></h2>
                                    {{{this.description}}}
                                </li> 
                                {{/each}}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            {{> footer}}
        </div>
    </div>
</body>
</html>
